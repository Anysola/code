{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anysola Code",
  "version": "0.1.0",
  "identifier": "com.anysola.code",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5620",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anysola Code",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#110f0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Anysola Code",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
