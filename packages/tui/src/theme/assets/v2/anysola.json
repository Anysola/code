    },
    "background": {
      "raised": {
        "max": "#d7d4cf"
      }
    },
    "diff": {
      "background": {
        "added": "#d6f0da",
        "removed": "#ffdedb"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "background": {
          "added": "#cae7cf",
          "removed": "#fbd3cf"
        }
      }
    }
  },
